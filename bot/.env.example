# ---------------------------------------------------------------------------
# Kotak research one-pager bot -- every setting, with its default.
#
# NOTHING here is required to start in the default mode (dry run, one-shot,
# local file). Each section says what it needs and when.
#
# Load it with:  node run.js --env-file /etc/kotak-research-bot/bot.env
# or, on systemd:  EnvironmentFile=/etc/kotak-research-bot/bot.env
#
# Secrets belong in this file (mode 0600, owned by the service user), NEVER in
# the repository and never on the command line, where `ps` would show them.
# ---------------------------------------------------------------------------

# === What the run is allowed to do ========================================
# dry-run  extract, validate, render, print. Writes nothing.  [DEFAULT]
# shadow   publish with publishState=shadow so the site can ignore it
# live     publish for real
BOT_MODE=dry-run

# Treat any extraction warning as a refusal to publish. Start false, consider
# true once you have seen a few weeks of real warnings.
BOT_FAIL_ON_WARNING=false

BOT_LOG_LEVEL=info            # debug | info | warn | error | silent
BOT_LOG_FORMAT=text           # text (journald) | json (log shipper)
BOT_STATE_DIR=./state         # lock, poll cursor, dead-letter; must be writable
#BOT_DEAD_LETTER_DIR=/var/lib/kotak-research-bot/dead-letter
#BOT_ENV_FILE=/etc/kotak-research-bot/bot.env
#BOT_CONFIG_FILE=/etc/kotak-research-bot/bot.json   # same keys, as JSON

# === What starts a run ====================================================
# once     process the reference given on the command line, then exit [DEFAULT]
# webhook  listen for Jamun to POST
# poll     re-list the source on a timer (needs a source that can list)
# watch    watch a directory Jamun writes into
TRIGGER_MODE=once
TRIGGER_POLL_INTERVAL_MS=300000
TRIGGER_MAX_PER_CYCLE=20

# --- TRIGGER_MODE=webhook only --------------------------------------------
WEBHOOK_HOST=127.0.0.1        # keep on loopback; terminate TLS in a proxy
WEBHOOK_PORT=8787
WEBHOOK_PATH=/jamun/report
WEBHOOK_HEALTH_PATH=/healthz
WEBHOOK_AUTH_MODE=hmac-sha256 # hmac-sha256 | token | none
#WEBHOOK_SECRET=change-me     # required unless WEBHOOK_AUTH_MODE=none
WEBHOOK_SIGNATURE_HEADER=x-jamun-signature
WEBHOOK_MAX_BODY_BYTES=65536

# === Where the PDF comes from =============================================
# http  a URL                    [DEFAULT] -- needs no credentials
# s3    S3 or any S3-compatible store
# file  a local path given with --file
# dir   a directory Jamun drops files into
SOURCE_TYPE=http

#SOURCE_URL=https://ks-oncloudpublic-reports.s3.ap-south-1.amazonaws.com/jaamoon-pdf-files/131440_1_Lenskart_Solutions__One_Pager_Q4FY26_Result_Update.pdf
#SOURCE_BASE_URL=https://ks-oncloudpublic-reports.s3.ap-south-1.amazonaws.com/jaamoon-pdf-files
# The public URL used for the "Download full report" button when the bot reads
# from disk. Without it the button is omitted (and a warning is raised).
#SOURCE_PUBLIC_BASE_URL=https://ks-oncloudpublic-reports.s3.ap-south-1.amazonaws.com/jaamoon-pdf-files
#SOURCE_HEADERS={"x-internal-auth":"..."}     # inline JSON or a path to a .json
SOURCE_TIMEOUT_MS=60000
SOURCE_RETRIES=4
SOURCE_MAX_BYTES=26214400     # 25 MiB

# --- SOURCE_TYPE=dir / TRIGGER_MODE=watch ---------------------------------
#SOURCE_DIR=/var/spool/jamun/incoming
#SOURCE_ARCHIVE_DIR=/var/spool/jamun/done    # consumed files are moved here
SOURCE_FILE_PATTERN=\.pdf$

# --- SOURCE_TYPE=s3 -------------------------------------------------------
#S3_BUCKET=ks-oncloudpublic-reports
#S3_PREFIX=jaamoon-pdf-files
S3_REGION=ap-south-1
#S3_ENDPOINT=https://minio.internal:9000     # any S3-compatible store
#S3_FORCE_PATH_STYLE=false
# Anonymous GET works on the reference bucket. LISTING does not (403
# AccessDenied), so TRIGGER_MODE=poll needs credentials with s3:ListBucket.
#AWS_ACCESS_KEY_ID=
#AWS_SECRET_ACCESS_KEY=
#AWS_SESSION_TOKEN=

# === Where the output goes ================================================
# strapi   Strapi REST                 [DEFAULT]
# http     POST the envelope anywhere
# file     write JSON + HTML to disk
# console  print (what --dry-run always uses)
PUBLISHER_TYPE=strapi

#STRAPI_URL=https://cms.internal.kotak.com   # required for shadow/live
#STRAPI_API_TOKEN=                            # required for shadow/live
STRAPI_COLLECTION=research-reports            # the PLURAL api id
STRAPI_API_PREFIX=/api
STRAPI_API_VERSION=auto       # auto | v4 | v5 -- auto probes the API
STRAPI_AUTH_SCHEME=Bearer     # '' sends the bare token
STRAPI_AUTH_HEADER=Authorization
#STRAPI_EXTRA_HEADERS={"x-gateway-key":"..."}  # for a WAF or API gateway
#STRAPI_LOCALE=en
STRAPI_TIMEOUT_MS=30000
STRAPI_RETRIES=4
STRAPI_ID_FIELD=reportId      # the attribute idempotency keys on
STRAPI_DRAFT_AND_PUBLISH=off  # off | on -- see INTEGRATION.md before turning on

# Rename any field without touching code. null drops the field entirely.
# The report date maps to `reportDate`: `publishedAt` is RESERVED by Strapi.
#STRAPI_FIELD_MAP={"stockName":"company_name","isin":"isin","template":null}

# --- PUBLISHER_TYPE=file / http -------------------------------------------
#PUBLISH_DIR=/var/lib/kotak-research-bot/published
#PUBLISH_URL=https://cms.internal.kotak.com/hooks/research-report
#PUBLISH_METHOD=POST
#PUBLISH_HEADERS={"authorization":"Bearer ..."}

# === Extraction tuning ====================================================
# Override the filename convention. Named groups: reportId, stock, template,
# period, type (or `rest`, which is split on the period token).
#FILENAME_PATTERN=^(?<reportId>\d+(?:_\d+)*)_(?<stock>.+?)__(?<rest>.+)$

# ticker -> { slug, isin }. The slug joins the block to its page; the PDF does
# not contain it, so it must come from here (or SLUG_TEMPLATE).
#BOT_TICKER_MAP=/etc/kotak-research-bot/tickers.json
#SLUG_TEMPLATE={name}-share-price   # derives a slug; always warns that it did

# Section headings -> id / title / tone / icon.
#SECTION_MAP=/etc/kotak-research-bot/sections.json
# Label regexes, if the PDF template ever renames them.
#LABEL_MAP={"cmp":"(?:current\\s*market\\s*price|\\(\\s*cmp\\s*\\))"}

DEFAULT_CURRENCY=INR
DEFAULT_HOLDING_PERIOD=12 months
MAX_REPORT_AGE_DAYS=7         # warn when a report is older than this
MAX_FUTURE_DAYS=2
EXPECTED_PAGE_COUNT=4         # warn when the template is not 1 + 3 boilerplate

# Where src/render.js lives, if the bot is deployed away from the repo.
#RENDERER_PATH=/opt/kotak-research-bot/src/render.js

# === Alerting =============================================================
# An INTERNAL endpoint only -- no external SaaS. The exit code, the ERROR log
# line and the dead-letter file work with or without this.
#ALERT_WEBHOOK_URL=https://alerts.internal.kotak.com/hooks/research-bot
#ALERT_WEBHOOK_HEADERS={"authorization":"Bearer ..."}
ALERT_TIMEOUT_MS=10000
