# Dev-only: the root package has no runtime deps. Playwright is installed
# ad hoc for tools/audit.js, so the root lockfile is noise.
/node_modules/
/package-lock.json

# The bot ships to Kotak's server, so bot/package-lock.json IS tracked --
# a regulated deployment needs reproducible installs.
node_modules/

*.log
.DS_Store

# Bot runtime state: dead-letter records, published-report ledger, poll
# cursors. Machine-local, environment-specific, and it can carry absolute
# paths from wherever the bot ran. It must never be committed.
bot/state/
